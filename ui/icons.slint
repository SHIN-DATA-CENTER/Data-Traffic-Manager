import { Theme } from "theme.slint";

// Outline icons drawn on a 24x24 grid.
export component Icon inherits Path {
    in property <string> name;
    in property <color> color: Theme.text-secondary;
    width: 18px;
    height: 18px;
    viewbox-x: 0;
    viewbox-y: 0;
    viewbox-width: 24;
    viewbox-height: 24;
    fit: ImageFit.fill;
    stroke: root.color;
    stroke-width: 1.8px;
    stroke-line-cap: round;
    stroke-line-join: round;
    fill: transparent;
    commands: root.name == "vpn" ? "M12 3 L5 6 V11 C5 15.5 8 19.2 12 21 C16 19.2 19 15.5 19 11 V6 Z M9.2 12 L11.2 14 L14.9 10.2"
        : root.name == "ethernet" ? "M5 8 H19 V19 H5 Z M9 8 V5 H15 V8 M9 19 V15.5 M12 19 V15.5 M15 19 V15.5"
        : root.name == "wifi" ? "M2.5 9.5 C8 4.2 16 4.2 21.5 9.5 M5.5 12.8 C9.4 9.3 14.6 9.3 18.5 12.8 M8.7 16 C10.6 14.4 13.4 14.4 15.3 16 M12 19.3 L12 19.4"
        : root.name == "cellular" ? "M5 19 V16 M9.5 19 V12.5 M14 19 V9 M18.5 19 V5"
        : root.name == "loopback" ? "M18.5 12 A6.5 6.5 0 1 1 16.6 7.4 M18.8 4.5 V8 H15.3"
        : root.name == "down" ? "M12 5 V19 M6 13 L12 19 L18 13"
        : root.name == "up" ? "M12 19 V5 M6 11 L12 5 L18 11"
        : root.name == "settings" ? "M4 7 H13 M17 7 H20 M4 17 H7 M11 17 H20 M15 4.8 V9.2 M9 14.8 V19.2"
        : root.name == "close" ? "M6 6 L18 18 M18 6 L6 18"
        : root.name == "trash" ? "M4 7 H20 M10 11 V17 M14 11 V17 M6 7 L7 20 H17 L18 7 M9 7 V4 H15 V7"
        : root.name == "folder" ? "M3 6 V18 A1 1 0 0 0 4 19 H20 A1 1 0 0 0 21 18 V9 A1 1 0 0 0 20 8 H12 L10 5 H4 A1 1 0 0 0 3 6 Z"
        : root.name == "reset" ? "M5 12 A7 7 0 1 0 7.1 7 M5 3.8 V7.8 H9"
        : root.name == "warning" ? "M12 4 L21 19 H3 Z M12 10 V14 M12 16.8 L12 16.9"
        : "M12 3 A9 9 0 1 0 12 21 A9 9 0 1 0 12 3 Z M3.5 12 H20.5 M12 3 C9 6 9 18 12 21 M12 3 C15 6 15 18 12 21";
}
